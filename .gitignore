# -------------------------------------------------
# VoxMinutes release runtime assets
# Required by Tauri Windows bundle
# -------------------------------------------------

# Keep normal exe files ignored, except release sidecar
!frontend/src-tauri/binaries/
!frontend/src-tauri/binaries/*.exe

# Keep runtime DLL resources
!frontend/src-tauri/resources-dll/
!frontend/src-tauri/resources-dll/*.dll
